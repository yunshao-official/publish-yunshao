picich J", "lastName": "Zupicich", "firstName": "Joel", "initials": "J"}, {"fullName": "Alkass K", "lastName": "Alkass", "firstName": "Kanar", "initials": "K", "authorId": {"type": "ORCID", "value": "0000-0002-9154-5393"}}, {"fullName": "Buchholz BA", "lastName": "Buchholz", "firstName": "Bruce A", "initials": "BA", "authorId": {"type": "ORCID", "value": "0000-0002-9531-551X"}}, {"fullName": "Druid H", "lastName": "Druid", "firstName": "Henrik", "initials": "H", "authorId": {"type": "ORCID", "value": "0000-0002-9198-023X"}}, {"fullName": "Jovinge S", "lastName": "Jovinge", "firstName": "Stefan", "initials": "S"}, {"fullName": "Frisén J", "lastName": "Frisén", "firstName": "Jonas", "initials": "J"}]}, "authorIdList": {"authorId": [{"type": "ORCID", "value": "0000-0002-8442-9968"}, {"type": "ORCID", "value": "0000-0002-8623-4910"}, {"type": "ORCID", "value": "0000-0002-9154-5393"}, {"type": "ORCID", "value": "0000-0002-9198-023X"}, {"type": "ORCID", "value": "0000-0002-9531-551X"}, {"type": "ORCID", "value": "0000-0003-1065-4107"}]}, "dataLinksTagsList": {"dataLinkstag": ["recommended_reviews", "wikipedia"]}, "journalInfo": {"issue": "5923", "volume": "324", "journalIssueId": 1613389, "dateOfPublication": "2009 Apr", "monthOfPublication": 4, "yearOfPublication": 2009, "journal": {"medlineAbbreviation": "Science", "title": "Science (New York, N.Y.)", "essn": "1095-9203", "issn": "0036-8075", "isoabbreviation": "Science", "nlmid": "0404511"}, "printPublicationDate": "2009-04-01"}, "pubYear": "2009", "pageInfo": "98-102", "abstractText": "It has been difficult to establish whether we are limited to the heart muscle cells we are born with or if cardiomyocytes are generated also later in life. We have taken advantage of the integration of carbon-14, generated by nuclear bomb tests during the Cold War, into DNA to establish the age of cardiomyocytes in humans. We report that cardiomyocytes renew, with a gradual decrease from 1% turning over annually at the age of 25 to 0.45% at the age of 75. Fewer than 50% of cardiomyocytes are exchanged during a normal life span. The capacity to generate cardiomyocytes in the adult human heart suggests that it may be rational to work toward the development of therapeutic strategies aimed at stimulating this process in cardiac pathologies.", "affiliation": "Department of Cell and Molecular Biology, Karolinska Institutet, SE-171 77 Stockholm, Sweden.", "publicationStatus": "ppublish", "language": "eng", "pubModel": "Print", "pubTypeList": {"pubType": ["Research Support, Non-U.S. Gov't", "research-article", "Research Support, U.S. Gov't, Non-P.H.S.", "Journal Article", "Research Support, N.I.H., Extramural"]}, "grantsList": {"grant": [{"agency": "NCRR NIH HHS", "acronym": "RR", "grantId": "RR13461", "orderIn": 0}, {"agency": "NIGMS NIH HHS", "acronym": "GM", "grantId": "P41 GM103483", "orderIn": 0}, {"agency": "NCRR NIH HHS", "acronym": "RR", "grantId": "P41 RR013461", "orderIn": 0}]}, "meshHeadingList": {"meshHeading": [{"majorTopic_YN": "N", "descriptorName": "Cell Nucleus", "meshQualifierList": {"meshQualifier": [{"majorTopic_YN": "N", "abbreviation": "CH", "qualifierName": "chemistry"}]}}, {"majorTopic_YN": "N", "descriptorName": "Myocytes, Cardiac", "meshQualifierList": {"meshQualifier": [{"majorTopic_YN": "Y", "abbreviation": "CY", "qualifierName": "cytology"}, {"majorTopic_YN": "N", "abbreviation": "ME", "qualifierName": "metabolism"}]}}, {"majorTopic_YN": "N", "descriptorName": "Stem Cells", "meshQualifierList": {"meshQualifier": [{"majorTopic_YN": "N", "abbreviation": "CY", "qualifierName": "cytology"}]}}, {"majorTopic_YN": "N", "descriptorName": "Humans"}, {"majorTopic_YN": "N", "descriptorName": "Carbon Radioisotopes", "meshQualifierList": {"meshQualifier": [{"majorTopic_YN": "N", "abbreviation": "AN", "qualifierName": "analysis"}]}}, {"majorTopic_YN": "N", "descriptorName": "Troponin I", "meshQualifierList": {"meshQualifier": [{"majorTopic_YN": "N", "abbreviation": "AN", "qualifierName": "a