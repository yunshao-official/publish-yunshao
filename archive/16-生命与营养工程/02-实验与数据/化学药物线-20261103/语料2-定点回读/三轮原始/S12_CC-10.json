": "DeMuth", "firstName": "Tyler M", "initials": "TM", "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Department of Medicine, University of Wisconsin-Madison, Madison, WI 53705, USA."}]}}, {"fullName": "Berres ME", "lastName": "Berres", "firstName": "Mark E", "initials": "ME", "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Biotechnolgoy Center, University of Wisconsin-Madison, Madison, WI 53705, USA."}]}}, {"fullName": "Eliceiri KW", "lastName": "Eliceiri", "firstName": "Kevin W", "initials": "KW", "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Laboratory for Optical and Computational Instrumentation, University of Wisconsin-Madison, Madison, WI 53706, USA."}]}}, {"fullName": "Vaughan LK", "lastName": "Vaughan", "firstName": "Laura K", "initials": "LK", "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Department of Biostatistics, University of Alabama-Birmingham, Birmingham, AL 35294, USA."}]}}, {"fullName": "Lary CW", "lastName": "Lary", "firstName": "Christine W", "initials": "CW", "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Department of Biostatistics, University of Alabama-Birmingham, Birmingham, AL 35294, USA."}]}}, {"fullName": "Beasley TM", "lastName": "Beasley", "firstName": "T Mark", "initials": "TM", "authorId": {"type": "ORCID", "value": "0000-0002-0803-1915"}, "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Department of Biostatistics, University of Alabama-Birmingham, Birmingham, AL 35294, USA; Geriatric Research Education and Clinical Center, Birmingham/Atlanta Veterans Administration Hospital, Birmingham, AL 35297, USA."}]}}, {"fullName": "Colman RJ", "lastName": "Colman", "firstName": "Ricki J", "initials": "RJ", "authorId": {"type": "ORCID", "value": "0000-0001-9706-0525"}, "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Department of Cell and Regenerative Biology, University of