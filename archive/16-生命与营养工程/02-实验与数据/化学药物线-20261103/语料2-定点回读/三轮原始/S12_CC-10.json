{"version": "6.9", "hitCount": 5, "request": {"queryString": "ABSTRACT:\"caloric restriction\" AND ABSTRACT:\"rhesus\" AND ABSTRACT:survival", "resultType": "core", "cursorMark": "*", "pageSize": 25, "sort": "", "synonym": false}, "resultList": {"result": [{"id": "41042069", "source": "MED", "pmid": "41042069", "pmcid": "PMC12686577", "fullTextIdList": {"fullTextId": ["PMC12686577"]}, "doi": "10.1111/acel.70254", "title": "Caloric Restriction Reprograms Adipose Tissues in Rhesus Monkeys.", "authorString": "Clark JP, Rhoads TW, McIlwain SJ, Polewski MA, Pavelec DM, Colman RJ, Anderson RM.", "authorList": {"author": [{"fullName": "Clark JP", "lastName": "Clark", "firstName": "Josef P", "initials": "JP", "authorId": {"type": "ORCID", "value": "0000-0003-1826-2618"}, "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Department of Medicine, University of Wisconsin-Madison, Madison, Wisconsin, USA."}]}}, {"fullName": "Rhoads TW", "lastName": "Rhoads", "firstName": "Timothy W", "initials": "TW", "authorId": {"type": "ORCID", "value": "0000-0001-7364-1122"}, "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Department of Nutritional Sciences, University of Wisconsin-Madison, Madison, Wisconsin, USA."}]}}, {"fullName": "McIlwain SJ", "lastName": "McIlwain", "firstName": "Sean J", "initials": "SJ", "authorId": {"type": "ORCID", "value": "0000-0002-3820-8400"}, "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Department of Biostatistics and Medical Informatics, University of Wisconsin-Madison, Madison, Wisconsin, USA."}, {"affiliation": "Carbone Comprehensive Cancer Center, University of Wisconsin-Madison, Madison, Wisconsin, USA."}]}}, {"fullName": "Polewski MA", "lastName": "Polewski", "firstName": "Michael A", "initials": "MA", "authorId": {"type": "ORCID", "value": "0000-0002-8759-2664"}, "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Department of Animal Sciences, University of Wis