ullName": "Jeffery U", "lastName": "Jeffery", "firstName": "Unity", "initials": "U"}, {"fullName": "Jonlin EC", "lastName": "Jonlin", "firstName": "Erica C", "initials": "EC"}, {"fullName": "Kaeberlein M", "lastName": "Kaeberlein", "firstName": "Matt", "initials": "M"}, {"fullName": "Karlsson EK", "lastName": "Karlsson", "firstName": "Elinor K", "initials": "EK"}, {"fullName": "Kerr KF", "lastName": "Kerr", "firstName": "Kathleen F", "initials": "KF"}, {"fullName": "Levine JM", "lastName": "Levine", "firstName": "Jonathan M", "initials": "JM"}, {"fullName": "Ma J", "lastName": "Ma", "firstName": "Jing", "initials": "J"}, {"fullName": "McClelland RL", "lastName": "McClelland", "firstName": "Robyn L", "initials": "RL"}, {"fullName": "Promislow DEL", "lastName": "Promislow", "firstName": "Daniel E L", "initials": "DEL"}, {"fullName": "Ruple A", "lastName": "Ruple", "firstName": "Audrey", "initials": "A"}, {"fullName": "Schwartz SM", "lastName": "Schwartz", "firstName": "Stephen M", "initials": "SM"}, {"fullName": "Shrager S", "lastName": "Shrager", "firstName": "Sandi", "initials": "S"}, {"fullName": "Snyder-Mackler NM", "lastName": "Snyder-Mackler", "firstName": "Noah M", "initials": "NM"}, {"fullName": "Tolbert MK", "lastName": "Tolbert", "firstName": "M Katherine", "initials": "MK"}, {"fullName": "Urfer SR", "lastName": "Urfer", "firstName": "Silvan R", "initials": "SR"}, {"fullName": "Wilfond BS", "lastName": "Wilfond", "firstName": "Benjamin S", "initials": "BS"}]}, "authorIdList": {"authorId": [{"type": "ORCID", "value": "0000-0001-5476-5963"}, {"type": "ORCID", "value": "0000-0001-7427-2402"}, {"type": "ORCID", "value": "0000-0002-5223-0217"}, {"type": "ORCID", "value": "0000-0002-7170-7703"}, {"type": "ORCID", "value": "0000-0002-9145-7043"}, {"type": "ORCID", "value": "0000-0003-1349-3484"}, {"type": "ORCID", "value": "0000-0003-2497-1939"}, {"type": "ORCID", "value": "0009-0009-2441-9694"}]}, "dataLinksTagsList": {"dataLinkstag": ["altmetrics", "supporting_data"]}, "journalInfo": {"issue": "3", "volume": "47", "journalIssueId": 3965723, "dateOfPublication": "2025 Jun", "monthOfPublication": 6, "yearOfPublication": 2025, "journal": {"medlineAbbreviation": "Geroscience", "title": "GeroScience", "essn": "2509-2723", "issn": "2509-2715", "nlmid": "101686284", "isoabbreviation": "Geroscience"}, "printPublicationDate": "2025-06-01"}, "pubYear": "2025", "pageInfo": "2851-2877", "abstractText": "Companion dogs are a powerful model for aging research given their morphologic and genetic variability, risk for age-related disease, and habitation of the human environment. In addition, the shorter life expectancy of dogs compared to human beings provides a unique opportunity for an accelerated timeline to test interventions that might extend healthy lifespan. The Test of Rapamycin In Aging Dogs (TRIAD) randomized clinical trial is a parallel-group, double-masked, randomized, placebo-controlled, multicenter trial that will test the ability of rapamycin to prolong lifespan and improve several healthspan metrics in healthy, middle-aged dogs recruited from Dog Aging Project participants. Here, we describe the rationale, design, and goals of the TRIAD randomized clinical trial, the first rigorous test of a pharmacologic intervention against biological aging with lifespan and healthspan metrics as endpoints to be performed outside of the laboratory in any species.", "affiliation": "Department of Small Animal Medicine and Surgery, University of Georgia, Athens, GA, USA. mericksn@uga.edu.", "publicationStatus": "ppublish", "language": "eng", "pubModel": "Print-Electronic", "pubTypeList": {"pubType": ["Clinical Trial Protocol", "Research Support, Non-U.S. Gov't", "review-article", "Journal Article", "Research Support, N.I.H., Extramural"]}, "grantsList": {"grant": [{"agency": "NIA NIH HHS", "acronym": "AG", "grantId": "R01 AG090843", "orderIn": 0}, {"agency": "NIA NIH HHS", "acronym": "AG", "grantId": "U19 AG057377", "orderIn": 0}, {"agency":