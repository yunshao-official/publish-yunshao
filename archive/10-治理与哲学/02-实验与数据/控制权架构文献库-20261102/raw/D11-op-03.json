01", "authorships": [{"author_position": "first", "author": {"id": "https://openalex.org/A5069913798", "display_name": "冀满红", "orcid": null, "observed_orcids": []}, "institutions": [], "countries": [], "is_corresponding": false, "raw_author_name": "冀满红", "raw_affiliation_strings": [], "raw_orcid": null, "affiliations": []}, {"author_position": "last", "author": {"id": "https://openalex.org/A5079024585", "display_name": "燕红忠", "orcid": null, "observed_orcids": []}, "institutions": [], "countries": [], "is_corresponding": false, "raw_author_name": "燕红忠", "raw_affiliation_strings": [], "raw_orcid": null, "affiliations": []}], "abstract_inverted_index": {"从近代早期企业的内部治理来看,轮船招商局实质上是一种'官权'与'股权'的合伙治理,轮船招商局的官款存局、官利制度是企业治理中的一系列'合约'安排,其剩余索取权由股东及其主要经营管理人员共同分享,剩余控制权则由督办及主管大官僚李鸿章掌握,他们同清政府一起享有剩余索取权.轮船招商局的管理人员既是股东又是官员这种双重身份本身就体现了'官权'与'股权'合伙治理的特征.轮船招商局中的生产要素构成、利润分配、权利分享以及人事安排都体现了这一治理特征.": [0]}, "cited_by_count": 0, "primary_location": {"id": "mag:900909739", "doi": null, "is_oa": false, "landing_page_url": "http://www.cqvip.com/QK/80292X/200404/9973708.html", "pdf_url": null, "source": {"id": "https://openalex.org/S4306551995", "display_name": "暨南学报：哲学社会科学版", "issn_l": null, "issn": null, "is_oa": false, "is_in_doaj": false, "is_core": false, "listed_in": [], "host_organization": null, "host_organization_name": null, "host_organization_lineage": [], "host_organization_lineage_names": [], "type": "journal"}, "license": null, "license_id": null, "version": null, "is_accepted": false, "is_published": false, "raw_source_name": "暨南学报：哲学社会科学版", "raw_type": null}}, {"id": "https://openalex.org/W7118828168", "doi": "https://doi.org/10.61189/158176zcolcy", "title": "AI+控制体重研究进展及展望", "publication_date": "2025-12-30", "authorships": [{"author_position": "first", "author": {"id": "https://openalex.org/A5122013318", "display_name": "颖 陈", "orcid": null, "observed_orcids": []}, "institutions": [{"id": "https://openalex.org/I24943067", "display_name": "Fudan University", "ror": "https://ror.org/013