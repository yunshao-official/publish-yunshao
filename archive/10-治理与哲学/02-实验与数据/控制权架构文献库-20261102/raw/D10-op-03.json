s": ["https://openalex.org/I179026463"]}]}], "abstract_inverted_index": {"随着金融行业与电子信息、互联网技术的不断融合发展，越来越多的学者将目光投入到金融权益保护这个课题中。在众多金融权益与金融资源中，信息资源有着举足轻重的地位。在当今时代，信息化和互联网化正在快速发展，除了资金、物质等实体资源，信息资源也已然成为了在经济竞争中的关键制胜因素。金融行业的相关企业可以通过对金融消费者的信息来分析从而做到精准服务，以便在激励的竞争中先拔头筹。但是，在机遇存在的同时，更高的风险也随之而来，尤其是体现在互联网时代下与金融消费者有关的电子信息领域中。目前为止，国内对于金融消费者信息权益的保护还有待于提高，我国应借鉴外国的先进经验，去粗取精、取长补短，完善包括金融消费有关的一系列法律体系，加强对于金融领域消费者的保护。": [0]}, "cited_by_count": 2, "primary_location": {"id": "doi:10.33142/mem.v6i2.16148", "doi": "https://doi.org/10.33142/mem.v6i2.16148", "is_oa": true, "landing_page_url": "https://doi.org/10.33142/mem.v6i2.16148", "pdf_url": "https://journals.viserdata.com/index.php/mem/article/download/16148/16160", "source": {"id": "https://openalex.org/S4210238722", "display_name": "现代经济管理", "issn_l": "2717-5502", "issn": ["2717-5502", "2717-5510"], "is_oa": true, "is_in_doaj": false, "is_core": false, "listed_in": [], "host_organization": "https://openalex.org/P4404660689", "host_organization_name": "Viser Technology Pte. Ltd.", "host_organization_lineage": ["https://openalex.org/P4404660689"], "host_organization_lineage_names": ["Viser Technology Pte. Ltd."], "type": "journal"}, "license": "cc-by-nc", "license_id": "https://openalex.org/licenses/cc-by-nc", "version": "publishedVersion", "is_accepted": true, "is_published": true, "raw_source_name": "现代经济管理", "raw_type": "journal-article"}}, {"id": "https://openalex.org/W4409946397", "doi": "https://doi.org/10.12677/ojls.2025.134106", "title": "Judicial Inspection and Advancement of Dispute Cases of Shareholder Qualification Confirmation", "publication_date": "2025-01-01", "authorships": [{"author_position": "first", "author": {"id": "https://openalex.org/A5117379952", "display_name": "蕊 邹", "orcid": null, "observed_orcids": []}, "institutions": [], "countries": [], "is_corresponding": true, "raw_author_name": "蕊 邹", "raw_affiliation_strings": [], "raw_orcid": null, "affiliations": []}], "abstract_inverted_index": {"股东资格确认纠纷是公司纠纷的判断起点，实务中起诉