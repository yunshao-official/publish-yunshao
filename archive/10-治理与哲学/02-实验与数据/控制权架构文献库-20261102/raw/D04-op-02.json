"raw_orcid": null, "affiliations": [{"raw_affiliation_string": "Zhejiang Hangxing Construction Group Co., Ltd. , Huzhou , Zhejiang , 313000 , China", "institution_ids": []}, {"raw_affiliation_string": "in Construction Engineering", "institution_ids": []}]}], "abstract_inverted_index": {"随着时代的进步，房屋从木结构变为混凝土结构，但建筑质量问题却越来越多。无论是小型建筑企业还是知名企业经营的项目，也有所谓的豆类项目，严重影响了房屋的整体质量，留下住房质量问题是人民生活的一个基本组成部分，它不仅与财产问题有关，而且与人民的安全问题有关。质量保证处管理不善和监督不力导致项目费用消耗低。在此基础上，简要分析总结了目前施工质量管理存在的问题和对策，希望这一简要介绍能为有关人员提供一些参考，为今后施工的发展提供可靠的参考，从而真正促进施工质量管理的发展。": [0]}, "cited_by_count": 0, "primary_location": {"id": "pmh:oai:ojs.68.183.239.143:article/5609", "doi": "https://doi.org/10.33142/aem.v4i3.5609", "is_oa": true, "landing_page_url": "https://journals.viserdata.com/index.php/aem/article/view/5609", "pdf_url": "https://journals.viserdata.com/index.php/aem/article/download/5609/5510", "source": {"id": "https://openalex.org/S4210194078", "display_name": "建筑工程与管理", "issn_l": "2661-4405", "issn": ["2661-4405", "2661-4413"], "is_oa": true, "is_in_doaj": false, "is_core": false, "listed_in": [], "host_organization": "https://openalex.org/P4404660689", "host_organization_name": "Viser Technology Pte. Ltd.", "host_organization_lineage": ["https://openalex.org/P4404660689"], "host_organization_lineage_names": ["Viser Technology Pte. Ltd."], "type": "journal"}, "license": "cc-by-nc-nd", "license_id": "https://openalex.org/licenses/cc-by-nc-nd", "version": "publishedVersion", "is_accepted": true, "is_published": true, "raw_source_name": "2661-4405", "raw_type": "info:eu-repo/semantics/article"}}, {"id": "https://openalex.org/W4414330266", "doi": "https://doi.org/10.63887/ssrp.2025.1.6.53", "title": "上市公司独立董事制度的有效性及完善路径研究", "publication_date": "2025-09-18", "authorships": [{"author_position": "first", "author": {"id": "https://openalex.org/A5119667438", "display_name": "杨娅", "orcid": null, "observed_orcids": []}, "institutions": [{"id": "https://openalex.org/I47948057", "display_name": "Kunming Metallurgy College", "ror": "https://ror.org/04586n774", "country_code": "CN", "type": "education", "lineage": ["https://openalex.org/I47948057"]}], "countries": ["CN"], "is_corresponding": true, "raw_author_name": "杨娅", "raw_affiliation_strings": ["昆明冶金高等专科学校"], "raw_orcid": null, "affiliations": [{"raw_affiliation_string": "昆明冶金高等专科学校", "institution_ids": ["https://openalex.org/I47948057"]}]}], "abstract_inverted_index": {"由于我国上市公司独立董事制度实行以来，在加强公司治理、保护投资者利益等方面发挥了一定的作用，但仍存在不少问题，如独立性不强，职能不清晰、行为不活跃等。对这些问题进行分析并提出相应的改进路径，对于进一步完善我国上市公司独立董事制度、健全公司治理结构具有重要的理论和实践意义。本研究采用历史分析法和实证分析法，对我国上市公司独立董事制度的有效性进行了深入的探讨。研究发现，虽然目前上市公司的独立董事制度在一定程度上有利于提高公司的治理效率，但其发挥的作用受到了独立董事自身素质、公司内部治理环境等因素的制约。因此，从独立董事选拔方式、任期设定、教育培训、待遇保障等方面提出完善我国上市公司独立董事制度的建议，期望通过这些方式提升独立董事的角色地位，更好地发挥其在公司治理中的作用。本研究旨在为公司治理研究和上市公司的实际运营提供新的理论与实证参考。": [0]}, "cited_by_count": 0, "primary_location": {"id": "doi:10.63887/ssrp.2025.1.6.53", "doi": "https://doi.org/10.63887/ssrp.2025.1.6.53", "is_oa": true, "landing_page_url": "https://doi.org/10.63887/ssrp.2025.1.6.53", "pdf_url": "https://www.sci-open.net/index.php/SSRP/article/download/3248/4185", "source": {"id": "https://openalex.org/S5407047643", "display_name": "社会科学研究与实践", "issn_l": "3058-8936", "issn": ["3058-8936", "3059-0272"], "is_oa": false, "is_in_doaj": false, "is_core": false, "listed_in": [], "host_organization": null, "host_organization_name": null, "host_organization_lineage": [], "host_organization_lineage_names": [], "type": "journal"}, "license": null, "license_id": null, "version": "publishedVersion", "is_accepted": true, "is_published": true, "raw_source_name": "社会科学研究与实践", "raw_type": "journal-article"}}], "group_by": []}