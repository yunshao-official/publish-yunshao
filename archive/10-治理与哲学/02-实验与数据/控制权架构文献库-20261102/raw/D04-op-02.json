, "observed_orcids": []}, "institutions": [], "countries": [], "is_corresponding": false, "raw_author_name": "哲瑞 黄", "raw_affiliation_strings": [], "raw_orcid": null, "affiliations": []}], "abstract_inverted_index": {"《民法典》虽为典型私法规范，事实上蕴涵着行政控权功能。本文从事前、事中与事后三个方面对《民法典》的行政控权功能进行论证。在事前维度，本文通过分析无权限行为、越权行为和滥用权利行为在《民法典》中的运用，论述了职权法定的重要性与基础性；在事中维度，本文论证了对行政行为的约束和行政程序的规范，是确保权力正确行使和《民法典》有效实施的关键；在事后维度，本文论证了有关主体通过行使监督权，对行政机关的权利进行约束和督促，明确行政机关没有依法行政的法律责任，并对权益受到损害的主体进行不同途径的救济，也是事前和事中控权的有力保障。": [0]}, "cited_by_count": 13, "primary_location": {"id": "doi:10.55375/jls.2023.2.5", "doi": "https://doi.org/10.55375/jls.2023.2.5", "is_oa": true, "landing_page_url": "https://doi.org/10.55375/jls.2023.2.5", "pdf_url": "https://qingpress.com/fs/Upload/Enclosures/2c1d7b1f-44ef-4f97-a155-cf7326786773.pdf", "source": {"id": "https://openalex.org/S4387279007", "display_name": "现代法学研究", "issn_l": "2790-3796", "issn": ["2790-3796"], "is_oa": false, "is_in_doaj": false, "is_core": false, "listed_in": [], "host_organization": null, "host_organization_name": null, "host_organization_lineage": [], "host_organization_lineage_names": [], "type": "journal"}, "license": null, "license_id": null, "version": "publishedVersion", "is_accepted": true, "is_published": true, "raw_source_name": "现代法学研究", "raw_type": "journal-article"}}, {"id": "https://openalex.org/W4411097515", "doi": "https://doi.org/10.37155/2717-5669-0601-38", "title": "全面质量控制在疾控中心理化实验室中的应用", "publication_date": "2025-01-01", "authorships": [{"author_position": "first", "author": {"id": "https://openalex.org/A5117856254", "display_name": "陈 伟", "orcid": null, "observed_orcids": []}, "institutions": [], "countries": [], "is_corresponding": false, "raw_author_name": "陈 伟", "raw_affiliation_strings": ["通辽市疾病预防控制中心"], "raw_orcid": null, "affiliations": [{"raw_affiliation_string": "通辽市疾病预防控制中心", "institution_ids": []}]}, {"author_position": "last", "author": {"id": "https://openalex.org/A5117856255", "display_name": "张丽敏", "orcid": null, "observed_or