rce": {"id": "https://openalex.org/S4306556870", "display_name": "纳税", "issn_l": null, "issn": null, "is_oa": false, "is_in_doaj": false, "is_core": false, "listed_in": [], "host_organization": null, "host_organization_name": null, "host_organization_lineage": [], "host_organization_lineage_names": [], "type": "journal"}, "license": null, "license_id": null, "version": null, "is_accepted": false, "is_published": false, "raw_source_name": "纳税", "raw_type": null}}, {"id": "https://openalex.org/W2272450928", "doi": null, "title": "股利所得税削减对权益资产价格的影响——以财税[2005-]102为背景的事件研究", "publication_date": "2015-05-15", "authorships": [{"author_position": "first", "author": {"id": "https://openalex.org/A5067620117", "display_name": "曾亚敏", "orcid": null, "observed_orcids": []}, "institutions": [], "countries": [], "is_corresponding": false, "raw_author_name": "曾亚敏", "raw_affiliation_strings": [], "raw_orcid": null, "affiliations": []}, {"author_position": "last", "author": {"id": "https://openalex.org/A5080829861", "display_name": "张俊生", "orcid": null, "observed_orcids": []}, "institutions": [], "countries": [], "is_corresponding": false, "raw_author_name": "张俊生", "raw_affiliation_strings": [], "raw_orcid": null, "affiliations": []}], "abstract_inverted_index": {"2005年6月13日中国财政部和国家税务总局联合颁布了财税[2005]102号文件，要求对个人投资者从上市公司取得的股息红利所得暂减按50％计入个人应纳税所得额。这为研究股利所得税对股票价格影响这个财务学经典问题提供了一个很好的“实验环境”。本文以此为背景的事件研究表明，股利所得税削减的消息宣告后，股票的累计超常收益率与股利支付水平正相关。这意味着，股利所得税变动对权益资产价格的影响在中国符合股利税的传统观。": [0]}, "cited_by_count": 0, "primary_location": {"id": "mag:2272450928", "doi": null, "is_oa": false, "landing_page_url": "http://www.oaj.pku.edu.cn/jjkx/CN/abstract/abstract52278.shtml", "pdf_url": null, "source": {"id": "https://openalex.org/S4306556929", "display_name": "经济科学", "issn_l": null, "issn": null, "is_oa": false, "is_in_doaj": false, "is_core": false, "listed_in": [], "host_organization": null, "host_organization_name": null, "host_organization_lineage": [], "host_organization_lineage_names": [], "type": "journal"}, "license": null, "license_id": null, "version": null, "is_accepted": false, "is_published": false, "raw_source_name": "经济科学", "raw_type": null}}, {"id": "https://openalex.org/W2266623090", "doi": null, "title": "第五讲 现行税制(之二)——对所得额的征税", "publication_date": "1987-01-01", "authorships": [{"author_position": "first", "author": {"id": "https://openalex.org/A5018866672", "display_name": "于振海", "orcid": null, "observed_orcids": []}, "institutions": [], "countries": [], "is_corresponding": true, "raw_author_name": "于振海", "raw_affiliation_strings": [], "raw_orcid": null, "affiliations": []}], "abstract_inverted_index": {"我国对所得额的征税起自建国之初,而比较系统地建立对所得额征税的制度,则是党的十一届三中全会以后开始的。目前,各种所得税在税收总额中的比重日益增加。所谓所得额,是指企业、经济组织的收益额(股息、红利、利息等)、利润额和个人的纯收入额等的总称。我国对所得额征税的意义是:": [0], "(一)增加国家财政收入。社会主义现代化建设需要巨量资金,税收是它的重要来源之一。国家通过多种税分配和再分配国民收入形成国家集中的税收收入。首先在流通领域对流转额征税,继而在分配领域对所得": [1]}, "cited_by_count": 0, "primary_location": {"id": "mag:2266623090", "doi": null, "is_oa": false, "landing_page_url": "http://www.cqvip.com/QK/96800X/198705/1003068752.html", "pdf_url": null, "source": {"id": "https://openalex.org/S2764703609", "display_name": "Contemporary Finance and Economics", "issn_l": null, "issn": null, "is_oa": false, "is_in_doaj": false, "is_core": false, "listed_in": [], "host_organization": "https://openalex.org/P4362724900", "host_organization_name": "Jiangxi University of Finance and Economics", "host_organization_lineage": ["https://openalex.org/P4362724900"], "host_organization_lineage_names": ["Jiangxi University of Finance and Economics"], "type": "journal"}, "license": null, "license_id": null, "version": null, "is_accepted": false, "is_published": false, "raw_source_name": "当代财经", "raw_type": null}}, {"id": "https://openalex.org/W2346831099", "doi": null, "title": "股利税差别化、现金分红与代理问题——基于财税[2012]85号文件的研究", "publication_date": "2016-01-01", "authorships": [{"author_position": "first", "author": {"id": "https://openalex.org/A5015610983", "display_name": "贾凡胜", "orcid": null, "observed_orcids": []}, "institutions": [], "countries": [], "is_corresponding": false, "raw_author_name": "贾凡胜", "raw_affiliation_strings": [], "raw_orcid": null, "affiliations": []}, {"author_position": "middle", "author": {"id": "https://openalex.org/A5013416272", "display_name": "吴昱", "orcid": null, "observed_orcids": []}, "institutions": [], "countries": [], "is_corresponding": false, "raw_author_name": "吴昱", "raw_affiliation_strings": [], "raw_orcid": null, "affiliations": []}, {"author_position": "last", "author": {"id": "https://openalex.org/A5011280876", "display_name": "廉轲", "orcid": null, "observed_orcids": []}, "institutions": [], "countries": [], "is_corresponding": false, "raw_author_name": "廉柯赟", "raw_affiliation_strings": [], "raw_orcid": null, "affiliations": []}], "abstract_inverted_index": {"本文以《关于实施上市公司股息红利差别化个人所得税政策有关问题的通知》的颁布为“自然实验”,研究资本市场对股利税调整的反应以及股利税调整对公司治理问题的影响。研究发现,政策颁布期间资本市场有显著为正的市场反应;相对而言,现金分红水平预期提升较大的公司市场反应显著较好;高管持股比例越高,公司累计超额收益率越高;第一大股东持股比例越高,公司累计超额收益率越低。这些结果表明,《通知》将提高现金分红的预期水平,从而缓解高管与股东间的委托代理问题,但却加剧了大股东与中小股东间的代理问题。本文的研究不仅丰富了分红与代理问题的文献,也为中国股利税改革提供了借鉴。": [0]}, "cited_by_count": 0, "primary_location": {"id": "mag:2346831099", "doi": null, "is_oa": false, "landing_page_url": "http://www.cqvip.com/QK/81584X/201601/667741583.html", "pdf_url": null, "source": {"id": "https://openalex.org/S4306545086", "display_name": "南开管理评论", "issn_l": null, "issn": null, "is_oa": false, "is_in_doaj": false, "is_core": false, "listed_in": [], "host_organization": null, "host_organization_name": null, "host_organization_lineage": [], "host_organization_lineage_names": [], "type": "journal"}, "license": null, "license_id": null, "version": null, "is_accepted": false, "is_published": false, "raw_source_name": "南开管理评论", "raw_type": null}}, {"id": "https://openalex.org/W2272179807", "doi": null, "title": "有限合伙制私募股权投资基金普通合伙人“附带收益”的税目研究", "publication_date": "2014-01-01", "authorships": [{"author_position": "first", "author": {"id": "https://openalex.org/A5006936691", "display_name": "刘雪滢", "orcid": null, "observed_orcids": []}, "institutions": [], "countries": [], "is_corresponding": true, "raw_author_name": "刘雪滢", "raw_affiliation_strings": [], "raw_orcid": null, "affiliations": []}], "abstract_inverted_index": {"有限合伙制是私募股权投资基金主要采用的组织形式,但我国关于普通合伙人附带收益如何征税在理论上并无定论,在税收实务中也没有统一规定。本文首先介绍美国各方关于附带收益属于资本利得亦或是普通收入的理论依据,进而分析讨论各种理论的利弊,最后借鉴提出一种折中的解决方法——以个体工商户生产经营所得税税率为基础,与允许普通合伙人决定按利息、股息、红利所得税税率纳税比例的自由选择权相结合的方式纳税,若普通合伙人不作选择则按普通收入税税率纳税。": [0]}, "cited_by_count": 0, "primary_location": {"id": "mag:2272179807", "doi": null, "is_oa": false, "landing_page_url": "http://www.cqvip.com/QK/87711X/201406/663710036.html", "pdf_url": null, "source": {"id": "https://openalex.org/S2764794927", "display_name": "Journal of Shanxi Finance and Tax College", "issn_l": null, "issn": null, "is_oa": false, "is_in_doaj": false, "is_core": false, "listed_in": [], "host_organization": null, "host_organization_name": null, "host_organization_lineage": [], "host_organization_lineage_names": [], "type": "journal"}, "license": null, "license_id": null, "version": null, "is_accepted": false, "is_published": false, "raw_source_name": "山西财政税务专科学校学报", "raw_type": null}}, {"id": "https://openalex.org/W2278564241", "doi": null, "title": "红利差别化税收政策的市场效应——基于财税〔2012〕85号文的实证研究", "publication_date": "2015-01-01", "authorships": [{"author_position": "first", "author": {"id": "https://openalex.org/A5047750086", "display_name": "张美霞", "orcid": null, "observed_orcids": []}, "institutions": [], "countries": [], "is_corresponding": true, "raw_author_name": "张美霞", "raw_affiliation_strings": [], "raw_orcid": null, "affiliations": []}], "abstract_inverted_index": {"2012年11月16日,财政部颁发85号文对个人投资者的股息红利所得实施差异化征税政策。采用事项研究法和多元回归法,对该政策发布时间窗口的市场反应进行研究,实证结果发现,市场整体做出了积极反应,但反应程度与公司盈利状况、股利政策、超额现金和股本结构等状况有关：上一年盈利但没有支付现金股利的公司和发放股票股利的公司、成长性较低因而剩余现金较多的公司市场反应显著为正;但市场反应与现金性资产比例、第一大股东持股比例和机构持股比例之间显著负相关;预期大股东和机构投资者受益较多,故不一定能达到鼓励个人投资者长期持股的政策目的。": [0]}, "cited_by_count": 0, "primary_location": {"id": "mag:227856