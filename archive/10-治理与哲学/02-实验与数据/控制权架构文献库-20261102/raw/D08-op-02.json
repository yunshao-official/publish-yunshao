cense": "cc-by-nc", "license_id": "https://openalex.org/licenses/cc-by-nc", "version": "publishedVersion", "is_accepted": true, "is_published": true, "raw_source_name": "现代经济管理", "raw_type": "journal-article"}}, {"id": "https://openalex.org/W888839481", "doi": null, "title": "以合理税制设计有效调整收入分配格局——访燕京华侨大学校长、著名经济学家华生", "publication_date": "2011-01-01", "authorships": [{"author_position": "first", "author": {"id": "https://openalex.org/A5072515585", "display_name": "张自然", "orcid": null, "observed_orcids": []}, "institutions": [], "countries": [], "is_corresponding": true, "raw_author_name": "张自然", "raw_affiliation_strings": [], "raw_orcid": null, "affiliations": []}], "abstract_inverted_index": {"4月26日，《中华人民共和国个人所得税法修正案（草案）》公布全文，并向社会公开征集意见。10天内有20多万条意见纷至沓来。其中对个税起征点的调整引起社会广泛关注。从该角度审视，个税起征点调整仅是一个切入点，而降低商品税和社保费，并加强对房产税和包括股息红利等财产税和资本利得税的征管征收，则在更宽视野和更深角度，提供了未来税制调整的选择空间。就这些问题，记者采访了燕京华侨大学校长、著名经济学家华生。": [0]}, "cited_by_count": 0, "primary_location": {"id": "mag:888839481", "doi": null, "is_oa": false, "landing_page_url": "http://www.cqvip.com/QK/82055A/201106/38073697.html", "pdf_url": null, "source": {"id": "https://openalex.org/S4306549360", "display_name": "投资北京", "issn_l": null, "issn": null, "is_oa": false, "is_in_doaj": false, "is_core": false, "listed_in": [], "host_organization": null, "host_organization_name": null, "host_organization_lineage": [], "host_organization_lineage_names": [], "type": "journal"}, "license": null, "license_id": null, "version": null, "is_accepted": false, "is_published": false, "raw_source_name": "投资北京", "raw_type": null}}, {"id": "https://openalex.org/W3194174889", "doi": null, "title": "xin san ban gua pai gong si ge ren suo de shui zheng ce fen xi yu wan shan", "publication_date": "2016-01-01", "authorships": [{"author_position": "first", "author": {"id": "https://openalex.org/A5109515205", "display_name": "Zhao Qian", "orcid": null, "observed_orcids": []}, "institutions": [], "countries": [], "is_corresponding": true, "raw_author_name": "Zh