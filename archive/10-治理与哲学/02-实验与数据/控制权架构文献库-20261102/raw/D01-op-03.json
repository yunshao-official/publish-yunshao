uthor_name": "洁 黄", "raw_affiliation_strings": ["上市公司信息披露制度，有利于资本市场的稳定发展。尽管在信息披露方面，已 有相应的法律法规，但由于我国证券发展较晚，披露制度在一些方面仍有不足，"], "raw_orcid": null, "affiliations": [{"raw_affiliation_string": "上市公司信息披露制度，有利于资本市场的稳定发展。尽管在信息披露方面，已 有相应的法律法规，但由于我国证券发展较晚，披露制度在一些方面仍有不足，", "institution_ids": []}]}, {"author_position": "last", "author": {"id": null, "display_name": "芸 张", "orcid": null, "observed_orcids": []}, "institutions": [], "countries": [], "is_corresponding": false, "raw_author_name": "芸 张", "raw_affiliation_strings": [], "raw_orcid": null, "affiliations": []}], "abstract_inverted_index": {"上市公司信息披露制度，有利于资本市场的稳定发展。尽管在信息披露方面，已有相应的法律法规，但由于我国证券发展较晚，披露制度在一些方面仍有不足，违规事件屡有发生，既损害中小股东、投资者的利益，又影响证券市场的发展。因此，有必要从我国信息披露制度中的不足之处出发，借鉴美国的有关规定，对上市公司信息披露制度作出一定的修改。": [0]}, "cited_by_count": 15, "primary_location": {"id": "doi:10.52288/jbi.26636204.2021.04.07", "doi": "https://doi.org/10.52288/jbi.26636204.2021.04.07", "is_oa": true, "landing_page_url": "https://doi.org/10.52288/jbi.26636204.2021.04.07", "pdf_url": "http://www.ccidanpo.org/sites/default/files/c26636204.2021.04.07.pdf", "source": {"id": "https://openalex.org/S4210212002", "display_name": "商业创新期刊", "issn_l": "2663-6204", "issn": ["2663-6204"], "is_oa": false, "is_in_doaj": false, "is_core": false, "listed_in": [], "host_organization": null, "host_organization_name": null, "host_organization_lineage": [], "host_organization_lineage_names": [], "type": "journal"}, "license": null, "license_id": null, "version": "publishedVersion", "is_accepted": true, "is_published": true, "raw_source_name": "商业创新期刊", "raw_type": "journal-article"}}, {"id": "https://openalex.org/W4412159221", "doi": "https://doi.org/10.63887/fem.2025.1.4.6", "title": "奇正藏药公司治理案例研究", "publication_date": "2025-07-10", "authorships": [{"author_position": "first", "author": {"id": "https://openalex.org/A5118887398", "display_name": "王英杰", "orcid": null, "observed_orcids": []}, "institutions": [{"id": "https://openalex.org/I187175081", "display_name": "Shaanxi University of Technology", "ror": "https://ror.org/056m91h77", "country_code": "CN", "type": "education", "lineage": ["https://openalex.org/I187175081"]}], "countries": ["CN"], "is_corresponding": true, "raw_author_name": "王英杰", "raw_affiliation_strings": ["陕西理工大学"], "raw_orcid": null, "affiliations": [{"raw_affiliation_string": "陕西理工大学", "institution_ids": ["https://openalex.org/I187175081"]}]}], "abstract_inverted_index": {"本文以西藏奇正藏药股份有限公司为案例，系统分析其公司治理实践及成效。研究表明，奇正藏药通过构建高比例独立董事的董事会结构、强化战略投资委员会等专门委员会的职能、确保信息披露透明化、优化投资者关系管理以及实施多期股权激励计划，形成了科学高效的治理体系。这些措施不仅保障了投资者权益，还推动了公司规范运作与可持续发展。奇正藏药的经验为民营企业完善治理结构、平衡利益相关者关系提供了重要借鉴。": [0]}, "cited_by_count": 0, "primary_location": {"id": "doi:10.63887/fem.2025.1.4.6", "doi": "https://doi.org/10.63887/fem.2025.1.4.6", "is_oa": true, "landing_page_url": "https://doi.org/10.63887/fem.2025.1.4.6", "pdf_url": "http://www.sci-open.net/index.php/FEM/article/download/1597/1760", "source": {"id": "https://openalex.org/S5407047649", "display_name": "经济管理前沿", "issn_l": "3058-9193", "issn": ["3058-9193", "3059-0248"], "is_oa": false, "is_in_doaj": false, "is_core": false, "listed_in": [], "host_organization": null, "host_organization_name": null, "host_organization_lineage": [], "host_organization_lineage_names": [], "type": "journal"}, "license": null, "license_id": null, "version": "publishedVersion", "is_accepted": true, "is_published": true, "raw_source_name": "经济管理前沿", "raw_type": "journal-article"}}], "group_by": []}